<?xml version="1.0"?>
<package format="2">
  <name>saggar_detection_ros</name>
  <version>1.0.0</version>
  <description>ROS package for Saggar detection using Mask R-CNN and Edge Detection</description>

  <maintainer email="user@example.com">Saggar Detection Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>message_generation</depend>
  <depend>message_runtime</depend>
  <depend>rosbag</depend>

  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-torch</exec_depend>

  <export>
  </export>
</package>
