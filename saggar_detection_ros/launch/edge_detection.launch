<?xml version="1.0"?>
<launch>
  <!-- Arguments -->
  <arg name="bag_file" default="" />
  <arg name="image_topic" default="/camera/image_raw" />
  <arg name="canny_low" default="50" />
  <arg name="canny_high" default="150" />
  <arg name="min_contour_area" default="500" />
  <arg name="max_contour_area" default="50000" />
  <arg name="use_bag_player" default="true" />
  <arg name="use_visualization" default="true" />

  <!-- Bag Player Node (optional) -->
  <group if="$(arg use_bag_player)">
    <node name="bag_player" pkg="saggar_detection_ros" type="bag_player_node.py" output="screen">
      <param name="bag_file" value="$(arg bag_file)" />
      <param name="image_topic" value="$(arg image_topic)" />
      <param name="output_topic" value="/saggar/image_raw" />
      <param name="loop" value="true" />
      <param name="rate" value="10.0" />
    </node>
  </group>

  <!-- Edge Detector Node -->
  <node name="edge_detector" pkg="saggar_detection_ros" type="edge_detector_node.py" output="screen">
    <param name="canny_low" value="$(arg canny_low)" />
    <param name="canny_high" value="$(arg canny_high)" />
    <param name="blur_kernel" value="5" />
    <param name="min_contour_area" value="$(arg min_contour_area)" />
    <param name="max_contour_area" value="$(arg max_contour_area)" />
    <param name="vertical_tolerance" value="20" />
    <param name="horizontal_tolerance" value="30" />
    <param name="morph_kernel_size" value="3" />
    <param name="use_adaptive_threshold" value="false" />
    <param name="publish_visualization" value="true" />
    <param name="input_topic" value="/saggar/image_raw" />
    <param name="output_topic" value="/saggar/detections/edge" />
    <param name="viz_topic" value="/saggar/visualization/edge" />
  </node>

  <!-- Visualization Node (optional) -->
  <group if="$(arg use_visualization)">
    <node name="visualization" pkg="saggar_detection_ros" type="visualization_node.py" output="screen">
      <param name="input_topic" value="/saggar/detections/edge" />
      <param name="marker_topic" value="/saggar/markers" />
      <param name="text_topic" value="/saggar/text_markers" />
      <param name="contour_topic" value="/saggar/contour_markers" />
      <param name="frame_id" value="camera_frame" />
    </node>
  </group>

  <!-- RViz -->
  <group if="$(arg use_visualization)">
    <node name="rviz" pkg="rviz" type="rviz" args="-d $(find saggar_detection_ros)/rviz/saggar_detection.rviz" />
  </group>

</launch>
